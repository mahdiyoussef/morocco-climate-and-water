aseline_temperature_c,\n       b.baseline_soil_moisture,\n       100.0 * (f.rainfall_mm - b.baseline_rainfall_mm) / nullif(b.baseline_rainfall_mm, 0) as rainfall_anomaly_pct,\n       (f.rainfall_mm - b.baseline_rainfall_mm) / nullif(b.rainfall_stddev_mm, 0) as rainfall_standardized_departure,\n       f.temperature_c - b.baseline_temperature_c as temperature_anomaly_c,\n       100.0 * (f.soil_moisture - b.baseline_soil_moisture) as soil_moisture_anomaly_pp,\n       2015 as baseline_start_year,\n       2019 as baseline_end_year\nfrom gold.fact_climate_monthly f join baseline b on f.site = b.site and f.month = b.month", "relation_name": "gold.mart_monthly_anomalies", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-06T19:38:48.877365Z", "completed_at": "2026-11-06T19:38:48.992023Z"}, {"name": "execute", "started_at": "2026-11-06T19:38:48.992767Z", "completed_at": "2026-11-06T19:38:51.182550Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 2.3093795776367188, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.morocco_observatory.mart_site_trends", "compiled": true, "compiled_code": "with annual as (\n  select site, year, sum(rainfall_mm) as rainfall_mm,\n         sum(temperature_c * hours) / sum(hours) as temperature_c\n  from gold.fact_climate_monthly group by site, year\n  having count(distinct month) = 12\n), sums as (\n  select site, count(*) as observation_years, min(year) as first_year, max(year) as last_year,\n         sum(year * 1.0) as sx, sum(year * year * 1.0) as sxx,\n         sum(rainfall_mm) as sy_rain, sum(year * rainfall_mm) as sxy_rain,\n         sum(temperature_c) as sy_temp, sum(year * temperature_c) as sxy_temp\n  from annual group by site\n)\nselect site, observation_years, first_year, last_year,\n       (observation_years * sxy_rain - sx * sy_rain) / nullif(observation_years * sxx - sx * sx, 0) as rainfall_slope_mm_per_year,\n       10.0 * (observation_years * sxy_temp - sx * sy_temp) / nullif(observation_years * sxx - sx * sx, 0) as temperature_slope_c_per_decade\nfrom sums", "relation_name": "gold.mart_site_trends", "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-06T19:38:51.189110Z", "completed_at": "2026-11-06T19:38:51.348454Z"}, {"name": "execute", "started_at": "2026-11-06T19:38:51.349056Z", "completed_at": "2026-11-06T19:38:53.137266Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 1.952665090560913, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.morocco_observatory.between_mart_monthly_anomalies_baseline_years__30__3.03e8ae3ed7", "compiled": true, "compiled_code": "\nselect * from gold.mart_monthly_anomalies\nwhere baseline_years is null or baseline_years < 3 or baseline_years > 30\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-06T19:38:51.096276Z", "completed_at": "2026-11-06T19:38:51.220489Z"}, {"name": "execute", "started_at": "2026-11-06T19:38:51.220996Z", "completed_at": "2026-11-06T19:38:53.229983Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 2.13881516456604, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.morocco_observatory.mart_water_year", "compiled": true, "compiled_code": "with periods as (\n  select *, case when month >= 10 then year + 1 else year end as water_year\n  from gold.fact_climate_monthly\n)\nselect site, water_year, count(distinct month) as months_covered,\n       case when count(distinct month) = 12 then true else false end as is_complete,\n       sum(rainfall_mm) as rainfall_mm,\n       sum(temperature_c * hours) / sum(hours) as temperature_c,\n       100.0 * sum(soil_moisture * hours) / sum(hours) as soil_moisture_pct,\n       sum(hours) as hours\nfrom periods group by site, water_year", "relation_name": "gold.mart_water_year", "batch_res