{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "raintrend",
  "position": {
    "x": 640,
    "y": 230,
    "width": 610,
    "height": 330,
    "z": 870,
    "tabOrder": 870
  },
  "visual": {
    "visualType": "lineChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendar"
                    }
                  },
                  "Property": "month_start"
                }
              },
              "queryRef": "Calendar.month_start"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "ClimateMonthly"
                    }
                  },
                  "Property": "Rainfall mm"
                }
              },
              "queryRef": "ClimateMonthly.Rainfall mm"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "ClimateMonthly"
                    }
                  },
                  "Property": "Rainfall Reference 2015 mm"
                }
              },
              "queryRef": "ClimateMonthly.Rainfall Reference 2015 mm"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Monthly rainfall and 2015 comparison · mm'"
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#19382E'"
                    }
                  }
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "11D"
                }
              }
            }
          }
        }
      ]
    }
  }
}