{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "samplemap",
  "position": {
    "x": 28,
    "y": 230,
    "width": 590,
    "height": 330,
    "z": 258,
    "tabOrder": 258
  },
  "visual": {
    "visualType": "azureMap",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Locations"
                    }
                  },
                  "Property": "name"
                }
              },
              "queryRef": "Locations.name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Locations"
                    }
                  },
                  "Property": "lat"
                }
              },
              "queryRef": "Locations.lat"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Locations"
                    }
                  },
                  "Property": "lon"
                }
              },
              "queryRef": "Locations.lon"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "ClimateMonthly"
                    }
                  },
                  "Property": "Rainfall mm"
                }
              },
              "queryRef": "ClimateMonthly.Rainfall mm"
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "ClimateMonthly"
                    }
                  },
                  "Property": "Mean Temperature C"
                }
              },
              "queryRef": "ClimateMonthly.Mean Temperature C"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "ClimateMonthly"
                    }
                  },
                  "Property": "Mapped Water Objects"
                }
              },
              "queryRef": "ClimateMonthly.Mapped Water Objects"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Rainfall at the sample locations'"
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#19382E'"
                    }
                  }
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "11D"
                }
              }
            }
          }
        }
      ]
    },
    "objects": {
      "bubbleLayer": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "sizeByValue": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    }
  }
}