      }
    ],
    "expressions": [
      {
        "name": "PostgresServer",
        "kind": "m",
        "expression": "\"localhost:5432\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "PostgresDatabase",
        "kind": "m",
        "expression": "\"observatory\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ]
  }
