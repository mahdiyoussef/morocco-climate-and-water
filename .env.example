# Generate actual local credentials with: python observatory/setup_platform.py
# Active Compose commands read .env.morocco. Secret values below are intentionally blank.
POSTGRES_USER=morocco_admin
POSTGRES_PASSWORD=
MINIO_ROOT_USER=morocco_storage
MINIO_ROOT_PASSWORD=
PIPELINE_WRITER_PASSWORD=
BI_READER_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_PASSWORD=
GRAFANA_PASSWORD=
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_PASSWORD=
AIRFLOW_UID=50000
POSTGRES_HOST_PORT=5433
# Optional serving overrides; defaults work for native local PostgreSQL.
SERVING_DB_HOST=127.0.0.1
SERVING_DB_PORT=5432
SERVING_DB_NAME=observatory
OBSERVATORY_DATA_BACKEND=postgres
